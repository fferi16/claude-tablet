#!/usr/bin/env python3
# Megkeresi a tablet nyitott portjait (vezeték nélküli ADB) – gyors aszinkron pásztázás.
import asyncio, sys
ip = sys.argv[1]; lo, hi = int(sys.argv[2]), int(sys.argv[3])
async def probe(p, sem, out):
    async with sem:
        try:
            r, w = await asyncio.wait_for(asyncio.open_connection(ip, p), 1.0)
            out.append(p); w.close()
        except Exception: pass
async def main():
    sem = asyncio.Semaphore(int(sys.argv[4]) if len(sys.argv)>4 else 100); out = []
    await asyncio.gather(*(probe(p, sem, out) for p in range(lo, hi + 1)))
    print(*sorted(out))
asyncio.run(main())
